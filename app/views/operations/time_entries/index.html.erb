<% page_title "Horas trabalhadas" %>
<% nav_location :op, "Horas trabalhadas" %>
<% breadcrumb ["Operação"], ["Horas trabalhadas"] %>
<% own_only = current_user.own_only?("horas") %>
<% capacity_text = "#{pluralize(@business_days, 'dia útil', plural: 'dias úteis')}#{" até #{date_br(Date.current).first(5)}" if @range.cover?(Date.current)}" %>

<div class="page-head">
  <div class="titles">
    <span class="section-label">Operação · <%= @period_label %></span>
    <h1>Horas trabalhadas</h1>
    <% if own_only %><p class="lead">Seu perfil vê e edita só os próprios lançamentos.</p><% end %>
  </div>
  <div class="actions">
    <%= form_with url: time_entries_path, method: :get do %>
      <%= preserved_filters(:periodo) %>
      <label class="sr-only" for="periodo">Período</label>
      <%= select_tag :periodo, options_for_select(@periods, @period), class: "select", id: "periodo", onchange: "this.form.requestSubmit()" %>
    <% end %>
    <% if policy(TimeEntry).create? %><%= drawer_link_to new_time_entry_path, class: "btn pri" do %><%= icon(:clock, size: 16, stroke: 1.8) %>Registrar horas<% end %><% end %>
  </div>
</div>

<div class="grid-kpi g4">
  <div class="card kpi"><span class="eyebrow">Total do período</span><span class="v"><%= hours_br(@kpis[:total], pad: true) %></span><span class="f"><%= capacity_text %> · <%= pluralize(@kpis[:people], "pessoa") %></span></div>
  <div class="card kpi"><span class="eyebrow">Em projetos</span><span class="v"><%= hours_br(@kpis[:projects], pad: true) %></span><span class="f"><%= @kpis[:total].positive? ? "#{(@kpis[:projects] * 100.0 / @kpis[:total]).round}% do total · #{pluralize(@kpis[:projects_count], 'projeto')}" : "nenhum lançamento" %></span></div>
  <div class="card kpi"><span class="eyebrow">Suporte e recorrentes</span><span class="v"><%= hours_br(@kpis[:other], pad: true) %></span><span class="f">consultoria, manutenção e chamados</span></div>
  <div class="card kpi"><span class="eyebrow">Média por dia útil</span><span class="v"><%= hours_br(@kpis[:daily], pad: true) %></span><span class="f"><%= capacity_text %></span></div>
</div>

<% if @kpis[:total].positive? %>
  <div class="grid-2">
    <section class="card card-body stack" aria-label="Horas por cliente">
      <div class="section-title"><h2>Por cliente</h2><span class="unit">HORAS · <%= @period_label.upcase %></span></div>
      <div class="hbars wide">
        <%= hour_bars(@by_company.map { |c, m| [ (current_user.can_read?("clientes") ? link_to(c.trade_name, company_path(c)) : c.trade_name), m ] } + (@others.positive? ? [ [ "Demais", @others ] ] : []), max: @by_company.first&.last, alt: [ "Demais" ]) %>
      </div>
      <p class="caption" style="margin:0">Base para a rentabilidade por cliente: horas convertidas em custo de mão de obra.</p>
    </section>

    <section class="card card-body stack" aria-label="Horas por usuário">
      <div class="section-title"><h2>Por usuário</h2><span class="unit">HORAS · CAPACIDADE <%= hours_br(@capacity) %></span></div>
      <div class="hbars wide">
        <% @by_user.each do |user, minutes| %>
          <% over = @capacity.positive? && minutes > @capacity %>
          <div class="hbar"><span class="who"><span class="avatar sm soft"><%= user.initials %></span><%= user.first_name %></span><div class="track"><div class="fill" style="width:<%= @capacity.positive? ? (minutes * 100.0 / @capacity).round.clamp(0, 100) : 0 %>%<%= ';background:var(--warn)' if over %>"></div></div><span class="val"><%= hours_br(minutes) %></span></div>
        <% end %>
      </div>
      <% @over_capacity.each do |user, minutes| %>
        <div class="callout warn"><span><b class="strong"><%= user.name %></b> passou da capacidade do período (<%= capacity_text %> × <%= Operations::TimeEntriesController::HOURS_PER_DAY %>h): <%= hours_br(minutes) %> registradas.</span></div>
      <% end %>
    </section>
  </div>
<% end %>

<%= form_with url: time_entries_path, method: :get, class: "toolbar" do %>
  <%= hidden_field_tag :periodo, @period, id: nil %>
  <%= search_field placeholder: "Descrição ou tarefa", label: "Buscar lançamento" %>
  <span class="spacer"></span>
  <% unless own_only %>
    <label class="sr-only" for="f-usr">Usuário</label>
    <%= select_tag :usuario, options_from_collection_for_select(@users, :id, :name, params[:usuario]), include_blank: "Todos os usuários", class: "select", id: "f-usr", onchange: "this.form.requestSubmit()" %>
  <% end %>
  <label class="sr-only" for="f-cli">Cliente</label>
  <%= select_tag :empresa, options_from_collection_for_select(@companies, :id, :trade_name, params[:empresa]), include_blank: "Todos os clientes", class: "select", id: "f-cli", onchange: "this.form.requestSubmit()" %>
  <label class="sr-only" for="f-proj">Projeto</label>
  <%= select_tag :projeto, options_for_select([ [ "Sem projeto", "sem" ] ] + @projects.map { |p| [ p.name, p.id ] }, params[:projeto]), include_blank: "Todos os projetos", class: "select", id: "f-proj", onchange: "this.form.requestSubmit()" %>
<% end %>

<section class="card" aria-label="Lançamentos de horas">
  <% if @entries.any? %>
    <div class="table-wrap">
      <table class="table cards">
        <thead><tr><th>Data</th><th>Usuário</th><th>Cliente</th><th>Projeto</th><th>Tarefa</th><th class="num">Duração</th><th>Descrição</th><th><span class="sr-only">Ações</span></th></tr></thead>
        <tbody>
          <% @entries.each do |entry| %>
            <tr>
              <td data-label="Data" class="mono"><%= date_br(entry.worked_on) %></td>
              <td data-label="Usuário"><%= entry.user.name %></td>
              <td data-label="Cliente"><%= link_to entry.company.trade_name, company_path(entry.company), class: "strong" %></td>
              <td data-label="Projeto" class="<%= 'muted' unless entry.project %>"><%= entry.project ? link_to(entry.project.name, project_path(entry.project)) : "—" %></td>
              <td data-label="Tarefa" class="<%= 'muted' unless entry.task || entry.ticket %>"><%= entry.task&.title || (entry.ticket ? link_to("Chamado #{entry.ticket.code}", ticket_path(entry.ticket)) : "—") %></td>
              <td data-label="Duração" class="num"><%= hours_br(entry.minutes, pad: true) %></td>
              <td data-label="Descrição"><%= entry.description.presence || "—" %></td>
              <td data-label="" class="right">
                <span class="row-actions">
                  <% if policy(entry).edit? %><%= drawer_link_to "Editar", edit_time_entry_path(entry), class: "link-btn" %><% end %>
                  <% if policy(entry).destroy? %><%= button_to "Excluir", time_entry_path(entry), method: :delete, class: "link-btn danger", form_class: "inline-form", form: { data: { turbo_confirm: "Excluir o lançamento de #{hours_br(entry.minutes)} em #{date_br(entry.worked_on)}?" } } %><% end %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
        <tfoot><tr><td data-label="">Total filtrado</td><td data-label=""></td><td data-label=""></td><td data-label=""></td><td data-label=""></td><td data-label="Total" class="num"><%= hours_br(@total, pad: true) %></td><td data-label="" class="muted" style="font-weight:500"><%= pluralize(@pager.total, "lançamento") %></td><td data-label=""></td></tr></tfoot>
      </table>
    </div>
    <%= render "shared/pagination", pager: @pager %>
    <div class="card-foot"><span>Perfis com permissão “Próprio” veem e editam apenas os próprios lançamentos</span></div>
  <% else %>
    <%= render "shared/empty", title: "Nenhum lançamento no período", text: "Registre as horas por cliente, com projeto, tarefa ou chamado quando houver. Troque o período no seletor acima para ver meses anteriores.", icon_name: :clock %>
  <% end %>
</section>
