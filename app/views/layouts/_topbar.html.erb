<header class="top">
  <button class="icon-btn ghost menu-btn" type="button" aria-label="Abrir menu" aria-controls="menu-lateral" data-nav-toggle><%= icon(:menu, size: 22, stroke: 1.8) %></button>
  <div class="crumb"><%= breadcrumb_html %></div>
  <button class="search-trigger" type="button" data-search-open aria-label="Busca global (⌘K)"><%= icon(:search, size: 16, stroke: 1.8) %><span>Buscar clientes, contatos, contratos…</span><span class="kbd">⌘K</span></button>

  <div class="user-menu notif-menu">
    <%# Sino em tempo real: o stream do usuário (NotificationsChannel) redesenha o botão e a lista. %>
    <%= render "notifications/bell_button", user: current_user %>
    <div class="popover notif-pop" id="notificacoes-pop" role="dialog" aria-label="Notificações">
      <div class="card-head"><h2>Notificações</h2><%= link_to "Ver todas", notifications_path, style: "font-size:13px;font-weight:600" %></div>
      <%= render "notifications/bell_list", user: current_user %>
    </div>
  </div>

  <div class="user-menu user-menu-avatar">
    <button class="avatar" type="button" aria-label="<%= current_user.name %>, <%= current_user.role.name %>" aria-haspopup="true" aria-expanded="false" data-popover-toggle="menu-usuario"><%= current_user.initials %></button>
    <div class="popover user-pop" id="menu-usuario" role="menu">
      <div class="card-head">
        <div>
          <h2><%= current_user.name %></h2>
          <span class="caption"><%= current_user.email %> · <%= current_user.role.name %></span>
        </div>
      </div>
      <% if policy(WhatsappConversation).index? %>
        <button class="notif signout" type="button" role="menuitemcheckbox" data-controller="whatsapp-sound-toggle" data-action="whatsapp-sound-toggle#toggle">
          <%= icon(:bell, size: 16, stroke: 1.8) %><span>Som dos avisos do WhatsApp: <b data-whatsapp-sound-toggle-target="state">desligado</b></span>
        </button>
      <% end %>
      <%= link_to edit_account_password_path, class: "notif signout", role: "menuitem" do %>
        <%= icon(:lock, size: 16, stroke: 1.8) %><span>Alterar senha</span>
      <% end %>
      <%= button_to destroy_user_session_path, method: :delete, class: "notif signout", role: "menuitem", form: { "data-turbo": "false" } do %>
        <%= icon(:logout, size: 16, stroke: 1.8) %><span>Sair</span>
      <% end %>
    </div>
  </div>
</header>
