<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <%= render "layouts/shared/head" %>
  </head>

  <body>
    <div class="app">
      <%= render "layouts/sidebar" %>
      <div class="main">
        <%= render "layouts/topbar" %>
        <main class="content" id="conteudo">
          <%= render "layouts/flash" %>
          <%= yield %>
        </main>
      </div>
    </div>
    <div class="overlay" data-overlay></div>
    <%# Stream do usuário: o sino (Notification.refresh_bell) e os avisos do navegador do WhatsApp
        (Whatsapp::Notifier). Permanente entre as visitas do Turbo, para não perder aviso nem o desbloqueio do som. %>
    <div id="notifications_stream" data-turbo-permanent hidden>
      <%= turbo_stream_from current_user, :notifications, channel: NotificationsChannel %>
      <% if policy(WhatsappConversation).index? %>
        <div id="whatsapp_alerts" data-controller="whatsapp-alerts" data-whatsapp-alerts-sound-value="<%= asset_path("whatsapp-aviso.wav") %>"></div>
      <% end %>
    </div>
    <%# Busca global (⌘K): consulta /busca.json enquanto a pessoa digita. %>
    <div class="palette" role="dialog" aria-label="Busca global" data-palette data-url="<%= search_path(format: :json) %>">
      <form class="palette-input" action="<%= search_path %>" method="get" data-turbo="false">
        <%= icon(:search, size: 18, stroke: 1.8) %>
        <input type="search" name="q" placeholder="Buscar em clientes, contratos, projetos, chamados e propostas" aria-label="Termo de busca" autocomplete="off" data-palette-input>
        <span class="kbd">Esc</span>
      </form>
      <div class="palette-results" data-palette-results style="max-height:52vh;overflow-y:auto;padding-bottom:8px"><div class="palette-group">Digite pelo menos 2 letras</div></div>
      <div class="palette-foot"><span>↑↓ navegar</span><span>Enter abrir</span><%= link_to "Ver todos os resultados", search_path, style: "margin-left:auto;font-weight:600", data: { palette_all: true } %></div>
    </div>
    <%# Gaveta lateral única: os formulários de criar e editar carregam aqui pelo Turbo Frame. %>
    <aside class="drawer" id="drawer" role="dialog" aria-modal="true" aria-label="Formulário">
      <turbo-frame id="drawer-frame"><div class="drawer-body caption">Carregando…</div></turbo-frame>
    </aside>
  </body>
</html>
