<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <%= render "layouts/shared/head" %>
  </head>

  <body>
    <div class="app">
      <%= render "layouts/sidebar" %>
      <div class="main">
        <%= render "layouts/topbar" %>
        <main class="content<%= ' wide' if content_for?(:wide) %>" id="conteudo">
          <%= render "layouts/flash" %>
          <%= yield %>
        </main>
      </div>
    </div>
    <div class="overlay" data-overlay></div>
  </body>
</html>
