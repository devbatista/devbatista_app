<%# Criar lead a partir da conversa (docs/design/whatsapp/conversas.html, gaveta "criar-lead"). %>
<% c = conversation %>
<%= render layout: "shared/drawer_form", locals: { title: "Criar lead a partir da conversa", cancel_path: whatsapp_conversation_path(c) } do %>
  <%= form_with model: lead, url: whatsapp_conversation_lead_path(c), method: :post, class: "form", data: { turbo_frame: "_top" } do |f| %>
    <div class="drawer-body form">
      <%= render "shared/form_errors", record: lead %>
      <div class="callout"><span>O lead nasce com a <b class="strong">origem WhatsApp</b> e esta conversa fica ligada a ele. As próximas mensagens geram a interação “WhatsApp” do dia no lead.</span></div>
      <span class="fieldset-title">Contato</span>
      <div class="form-grid">
        <div class="field full"><%= f.label :name do %>Nome <span class="req">*</span><% end %><%= f.text_field :name, class: "input", required: true %>
          <% if c.saved_name || c.profile_name %><span class="hint">Veio do nome <%= c.saved_name ? "na agenda" : "do perfil" %> no WhatsApp; ajuste se precisar</span><% end %></div>
        <div class="field full"><%= f.label :company_name, "Empresa" %><%= f.text_field :company_name, class: "input", placeholder: "Nome da empresa, se houver" %></div>
        <div class="field"><%= f.label :whatsapp, "WhatsApp" %><%= f.telephone_field :whatsapp, class: "input mono", placeholder: "Não compartilhado" %>
          <span class="hint"><%= c.wa_id ? "Telefone recebido do WhatsApp" : "O contato não compartilhou o telefone. A conversa fica ligada pelo ID do WhatsApp." %></span></div>
        <div class="field"><%= f.label :email, "E-mail" %><%= f.email_field :email, class: "input", placeholder: "nome@empresa.com.br" %></div>
      </div>
      <span class="fieldset-title">Qualificação</span>
      <div class="form-grid">
        <div class="field"><%= f.label :origin do %>Origem <span class="req">*</span><% end %><%= f.select :origin, Lead.options_for_origin, {}, class: "select", required: true %></div>
        <div class="field"><%= f.label :service_id, "Serviço de interesse" %><%= f.collection_select :service_id, Service.available, :id, :name, { include_blank: "Selecione" }, class: "select" %></div>
        <div class="field"><%= f.label :user_id do %>Responsável <span class="req">*</span><% end %><%= f.collection_select :user_id, User.active.by_name, :id, :name, {}, class: "select" %></div>
        <div class="field"><%= f.label :status do %>Status <span class="req">*</span><% end %><%= f.select :status, Lead::OPEN_STATUSES.map { |s| [ Lead::STATUS_LABELS[s], s ] }, {}, class: "select" %></div>
        <div class="field full"><%= f.label :notes, "Observações" %><%= f.text_area :notes, class: "textarea" %></div>
      </div>
    </div>
    <div class="drawer-foot">
      <%= link_to "Cancelar", whatsapp_conversation_path(c), class: "btn", data: { close: true, turbo_frame: "_top" } %>
      <%= f.submit "Criar lead e vincular", class: "btn pri" %>
    </div>
  <% end %>
<% end %>
