<% nav_location :adm, "Permissões" %>
<% breadcrumb ["Administração"], ["Permissões"] %>
<% editable = @roles.any? { |role| policy(role).update? } %>

<div class="page-head">
  <div class="titles">
    <span class="section-label">Administração · Perfis de acesso</span>
    <h1>Permissões</h1>
    <p class="lead">O que cada perfil pode fazer em cada módulo. O menu mostra apenas os módulos com acesso.</p>
  </div>
  <% if editable %>
    <div class="actions"><button class="btn pri" type="submit" form="matriz">Salvar alterações</button></div>
  <% end %>
</div>

<div class="callout">
  <span><b class="strong">A regra é aplicada no servidor</b>, em todas as ações, e não só escondendo itens do menu. Uma mudança aqui vale no próximo clique de cada usuário e fica registrada em <%= link_to "Logs", admin_audit_logs_path %>. No Dashboard e nos relatórios, cartões financeiros aparecem apenas para Administrador e Financeiro.</span>
</div>

<%= form_with url: admin_permissions_path, method: :patch, id: "matriz", class: "card", data: { turbo: false } do %>
  <div class="card-head"><h2>Matriz de permissões por módulo</h2></div>
  <div class="table-wrap">
    <table class="table cards matrix">
      <thead><tr><th>Módulo</th><% @roles.each do |role| %><th><%= role.name %></th><% end %></tr></thead>
      <tbody>
        <% Role::AREAS.each do |area, label| %>
          <tr>
            <td data-label="Módulo" class="strong"><%= label %></td>
            <% @roles.each do |role| %>
              <% level = role.level_for(area) %>
              <td data-label="<%= role.name %>">
                <% if policy(role).update? %>
                  <%= select_tag "permissions[#{role.key}][#{area}]", permission_level_options(level),
                        class: "select perm v-#{level}", "aria-label": "#{role.name} — #{label}" %>
                <% else %>
                  <span class="pv v-<%= level %>" title="<%= role.admin? ? 'Administrador sempre tem acesso total' : nil %>"><%= Admin::PermissionsHelper::LEVEL_LABELS[level] %></span>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<section class="card">
  <div class="card-head"><h2>O que cada nível permite</h2></div>
  <div class="legend-grid">
    <% Admin::PermissionsHelper::LEVEL_LABELS.each do |level, label| %>
      <div><span class="pv v-<%= level %>"><%= label %></span><%= Admin::PermissionsHelper::LEVEL_DESCRIPTIONS[level] %></div>
    <% end %>
  </div>
</section>
