<% page_title "Dashboard" %>
<% nav_location :dash %>
<% breadcrumb ["Dashboard"] %>

<div class="page-head">
  <div class="titles">
    <span class="section-label"><%= l(Date.current, format: "%B de %Y").capitalize %></span>
    <h1>Olá, <%= current_user.first_name %></h1>
    <p class="lead">O dashboard executivo mostra os 12 cartões do mês assim que os módulos de clientes, comercial, operação e financeiro estiverem no ar.</p>
  </div>
</div>

<section class="card">
  <div class="empty">
    <span class="ic"><%= icon(:dash, size: 22, stroke: 1.8) %></span>
    <h2>Clientes, Comercial e Operação no ar</h2>
    <p style="margin:0;max-width:520px">Empresas, contratos, pipeline, propostas, projetos, tarefas, horas, chamados, documentos, busca e notificações já funcionam. Os itens marcados como “em breve” no menu chegam módulo a módulo.</p>
    <div class="row wrap" style="justify-content:center">
      <% if policy(Company).index? %><%= link_to "Empresas", companies_path, class: "btn" %><% end %>
      <% if policy(Contract).index? %><%= link_to "Contratos", contracts_path, class: "btn" %><% end %>
      <% if policy(Project).index? %><%= link_to "Projetos", projects_path, class: "btn" %><% end %>
      <% if policy(Ticket).index? %><%= link_to "Suporte", tickets_path, class: "btn" %><% end %>
    </div>
  </div>
</section>
