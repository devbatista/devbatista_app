<% nav_location :com, "Propostas" %>
<% breadcrumb ["Comercial"], ["Propostas", proposals_path], [@proposal.code, proposal_path(@proposal)], ["Editar"] %>
<div class="page-head">
  <div class="titles">
    <span class="section-label">Proposta <%= @proposal.code %></span>
    <h1><%= @proposal.title %></h1>
  </div>
</div>
<%= render "form", proposal: @proposal %>
