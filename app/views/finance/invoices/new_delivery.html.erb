<% nav_location :fin, "Faturas" %>
<% breadcrumb ["Financeiro", finance_path], ["Faturas", invoices_path], [@invoice.code, invoice_path(@invoice)], ["Enviar por e-mail"] %>
<% d = @delivery %>
<div class="form-page">
  <%= render layout: "shared/drawer_form", locals: { title: "Enviar fatura por e-mail", cancel_path: invoice_path(@invoice) } do %>
    <%= form_with model: d, scope: :delivery, url: delivery_invoice_path(@invoice), method: :post, class: "form", data: { turbo_frame: "_top" } do |f| %>
      <div class="drawer-body form">
        <% if d.errors.any? %><div class="callout crit" role="alert"><span><%= d.errors.full_messages.to_sentence %></span></div><% end %>
        <div class="callout"><span>Vai o PDF de <%= @invoice.code %> (<%= brl(@invoice.total_cents) %>, vence <%= date_br(@invoice.due_on) %>) anexado, com o botão “Ver fatura”, que abre a fatura com o Pix.
          O PDF enviado fica em Documentos. <%= link_to "Conferir o PDF", pdf_invoice_path(@invoice), target: "_blank", class: "strong" %></span></div>
        <div class="field">
          <%= f.label :to do %>Para <span class="req">*</span><% end %>
          <%= f.text_field :to, class: "input", required: true, placeholder: "financeiro@cliente.com.br", autocomplete: "off" %>
          <span class="hint">Vários e-mails separados por vírgula<%= ". Sem e-mail no contato nem na empresa: preencha aqui" if @invoice.recipient_email.blank? %></span>
        </div>
        <div class="field"><%= f.label :cc, "Cópia" %><%= f.text_field :cc, class: "input", placeholder: "Opcional", autocomplete: "off" %></div>
        <div class="field"><%= f.label :subject do %>Assunto <span class="req">*</span><% end %><%= f.text_field :subject, class: "input", required: true %></div>
        <div class="field"><%= f.label :message do %>Mensagem <span class="req">*</span><% end %><%= f.text_area :message, class: "textarea", required: true, style: "min-height:220px" %></div>
        <label class="check"><%= f.check_box :copy_me %> Enviar uma cópia para mim (<%= current_user.email %>)</label>
        <p class="caption" style="margin:0">Sai de <%= Setting[:mailer_sender] %>; a resposta do cliente vai para <%= current_user.email %>.</p>
      </div>
      <div class="drawer-foot">
        <%= link_to "Cancelar", invoice_path(@invoice), class: "btn", data: { close: true, turbo_frame: "_top" } %>
        <%= f.submit "Enviar fatura", class: "btn pri" %>
      </div>
    <% end %>
  <% end %>
</div>
