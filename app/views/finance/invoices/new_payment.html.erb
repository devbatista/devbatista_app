<% inv = @invoice %>
<% nav_location :fin, "Faturas" %>
<% breadcrumb ["Financeiro", finance_path], ["Faturas", invoices_path], [inv.code, invoice_path(inv)], ["Registrar pagamento"] %>
<div class="form-page">
  <%= render layout: "shared/drawer_form", locals: { title: "Registrar pagamento", cancel_path: invoice_path(inv) } do %>
    <%= form_with scope: :payment, url: payment_invoice_path(inv), method: :patch, class: "form", data: { turbo_frame: "_top" } do |f| %>
      <div class="drawer-body form">
        <%= render "shared/form_errors", record: inv %>
        <div class="callout<%= ' crit' if inv.overdue? %>"><span><%= inv.company.trade_name %> · <%= inv.code %> · <b class="strong"><%= brl(inv.total_cents) %></b> · vence <%= date_br(inv.due_on) %><%= " · #{days_text(inv.days_late)} de atraso" if inv.overdue? %></span></div>
        <p class="caption" style="margin:0">Pagamento integral: a fatura e as <%= pluralize(inv.items.size, "receita") %> dela ficam pagas nesta data, cada uma pelo seu valor. Se o cliente pagou um valor diferente, cancele a fatura e emita outra.</p>
        <div class="field"><%= f.label :paid_on do %>Data do pagamento <span class="req">*</span><% end %><%= f.date_field :paid_on, value: params.dig(:payment, :paid_on) || Date.current, class: "input", required: true, max: Date.current %></div>
        <div class="field"><%= f.label :notes, "Observações" %><%= f.text_area :notes, class: "textarea", placeholder: "Ex.: Pix recebido no Inter" %></div>
      </div>
      <div class="drawer-foot">
        <%= link_to "Cancelar", invoice_path(inv), class: "btn", data: { close: true, turbo_frame: "_top" } %>
        <%= f.submit "Confirmar pagamento", class: "btn pri" %>
      </div>
    <% end %>
  <% end %>
</div>
