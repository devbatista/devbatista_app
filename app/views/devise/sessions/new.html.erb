<% page_title "Entrar" %>
<div class="stack" style="gap:6px">
  <h1 style="font-size:24px">Entrar</h1>
  <p class="lead">Acesso restrito à equipe da DevBatista.</p>
</div>

<%= form_for resource, as: resource_name, url: session_path(resource_name), html: { class: "form" }, data: { turbo: false } do |f| %>
  <div class="field">
    <%= f.label :email, "E-mail" %>
    <%= f.email_field :email, class: "input", autofocus: true, autocomplete: "username", placeholder: "voce@devbatista.com", required: true %>
  </div>
  <div class="field">
    <div class="row" style="justify-content:space-between">
      <%= f.label :password, "Senha" %>
      <%= link_to "Esqueci minha senha", new_password_path(resource_name), style: "font-size:13px;font-weight:600" %>
    </div>
    <div class="pw">
      <%= f.password_field :password, class: "input", autocomplete: "current-password", required: true %>
      <button class="icon-btn ghost" type="button" aria-label="Mostrar senha" aria-pressed="false" data-password-toggle><%= icon(:eye, size: 18, stroke: 1.8) %></button>
    </div>
  </div>
  <%= f.submit "Entrar", class: "btn pri block" %>
<% end %>

<p class="caption" style="margin:0;display:flex;gap:8px;align-items:flex-start">
  <%= icon(:lock, size: 16, stroke: 1.8, style: "flex:none;margin-top:1px") %>
  <span>Por segurança, a conta é bloqueada por 15 minutos após 5 tentativas de login inválidas seguidas. Todos os acessos ficam registrados na auditoria.</span>
</p>
