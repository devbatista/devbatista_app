<%# Serve ao "Esqueci minha senha" e ao convite de usuário novo (Admin::UsersController#create). %>
<% url = edit_password_url(@resource, reset_password_token: @token) %>
<% if @resource.sign_in_count.zero? %>
  <% content_for :preheader, "Sua conta foi criada. Defina sua senha para entrar." %>
  <%= mail_label "Acesso" %>
  <%= mail_title "Bem-vindo ao Admin DevBatista" %>
  <%= mail_text "Olá, #{@resource.first_name}. Sua conta foi criada com o perfil #{@resource.role.name}. Para entrar, defina a sua senha." %>
  <%= mail_button "Definir minha senha", url %>
<% else %>
  <% content_for :preheader, "Use o link para criar uma nova senha." %>
  <%= mail_label "Acesso" %>
  <%= mail_title "Redefinir senha" %>
  <%= mail_text "Olá, #{@resource.first_name}. Recebemos um pedido para redefinir a senha da sua conta (#{@resource.email})." %>
  <%= mail_button "Criar nova senha", url %>
<% end %>
<%= mail_note do %>
  O link vale por <%= mail_duration(Devise.reset_password_within) %> e só pode ser usado uma vez.
  <% unless @resource.sign_in_count.zero? %>Se você não fez o pedido, ignore este e-mail: sua senha continua a mesma.<% end %>
<% end %>
<%= mail_link_fallback url %>
