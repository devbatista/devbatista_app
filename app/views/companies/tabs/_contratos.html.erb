<div class="card">
  <div class="card-head">
    <h2>Contratos</h2>
    <% if policy(Contract).create? %><%= drawer_link_to new_contract_path(empresa: @company.id), class: "btn sm" do %><%= icon(:plus, size: 14, stroke: 2) %>Novo contrato<% end %><% end %>
  </div>
  <% if @contracts.any? %>
    <div class="table-wrap">
      <table class="table cards">
        <thead><tr><th>Número</th><th>Título</th><th>Vigência</th><th class="num">Valor</th><th>Status</th></tr></thead>
        <tbody>
          <% @contracts.each do |contract| %>
            <tr data-href="<%= contract_path(contract) %>" class="<%= 'soon' if contract.expiring? %>">
              <td data-label="Número"><%= link_to contract.code, contract, class: "strong mono" %></td>
              <td data-label="Título" class="strong"><%= contract.title %></td>
              <td data-label="Vigência" class="mono nowrap"><%= date_br(contract.start_date) %> – <%= date_br(contract.end_date) %><span class="cell-sub"><%= contract.renewal_text.capitalize %></span></td>
              <td data-label="Valor" class="num nowrap"><%= brl(contract.value_cents) %><span class="cell-sub"><%= contract.periodicity_label %></span></td>
              <td data-label="Status"><%= status_badge_for(contract) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render "shared/empty", title: "Nenhum contrato", text: "Contratos vigentes e encerrados aparecem aqui." %>
  <% end %>
</div>
