<%# Vincular a conversa a um lead ou contato (docs/design/whatsapp/conversas.html, modal "vincular"),
    na gaveta lateral. A busca recarrega só a gaveta; vincular recarrega a conversa. %>
<% nav_location :wa, "Conversas" %>
<% breadcrumb ["WhatsApp"], ["Conversas", whatsapp_conversation_path(@conversation)], ["Vincular"] %>
<% c = @conversation %>
<div class="form-page">
  <%= render layout: "shared/drawer_form", locals: { title: "Vincular a lead ou contato", cancel_path: whatsapp_conversation_path(c) } do %>
    <div class="drawer-body form">
      <%= form_with url: new_whatsapp_conversation_link_path(c), method: :get, class: "row", style: "gap:8px", data: { turbo_frame: "drawer-frame" } do %>
        <label class="search-field" style="flex:1"><span class="sr-only">Buscar lead ou contato</span><%= icon(:search, size: 16, stroke: 1.8) %>
          <%= search_field_tag :q, @term, class: "input", id: nil, style: "width:100%", placeholder: "Nome, empresa, e-mail ou telefone", autocomplete: "off" %></label>
        <button class="btn" type="submit">Buscar</button>
      <% end %>
      <%= form_with url: whatsapp_conversation_link_path(c), method: :post, id: "wa-link-form", class: "form", data: { turbo_frame: "_top" } do %>
        <% if @leads.empty? && @contacts.empty? %>
          <p class="caption" style="margin:0"><%= @term.present? ? "Nada encontrado para “#{@term}”." : "Nenhum cadastro com o telefone desta conversa. Busque pelo nome, empresa, e-mail ou telefone." %></p>
        <% else %>
          <% unless @term.present? %><span class="caption">Cadastros com o telefone desta conversa</span><% end %>
          <div class="results" role="radiogroup" aria-label="Resultados">
            <% (@leads.to_a + @contacts.to_a).each_with_index do |record, i| %>
              <label>
                <%= radio_button_tag :alvo, "#{record.class.name}:#{record.id}", i.zero?, id: nil, required: true %>
                <% if record.is_a?(Lead) %>
                  <span><span class="strong"><%= record.display_name %></span><span class="cell-sub"><%= [ (record.name if record.company_name.present?), record.status_label, record.origin_label ].compact.join(" · ") %></span></span>
                  <span class="badge b-info sm-badge">Lead</span>
                <% else %>
                  <span><span class="strong"><%= record.name %></span><span class="cell-sub"><%= [ record.company.trade_name, record.position ].compact_blank.join(" · ") %></span></span>
                  <span class="badge b-good sm-badge">Contato</span>
                <% end %>
              </label>
            <% end %>
          </div>
          <% if c.wa_id %>
            <label class="check"><%= check_box_tag :salvar_telefone, "1", true, id: nil %> Salvar o telefone <span class="mono"><%= Whatsapp::Phone.national_label(c.wa_id) %></span> no WhatsApp do cadastro, se estiver vazio</label>
          <% end %>
          <div class="callout"><span>As próximas mensagens desta conversa geram a interação “WhatsApp” do dia no lead ou na oportunidade aberta da empresa.</span></div>
        <% end %>
      <% end %>
    </div>
    <div class="drawer-foot">
      <%= link_to "Cancelar", whatsapp_conversation_path(c), class: "btn", data: { close: true, turbo_frame: "_top" } %>
      <% if @leads.any? || @contacts.any? %><button class="btn pri" type="submit" form="wa-link-form">Vincular conversa</button><% end %>
    </div>
  <% end %>
</div>
