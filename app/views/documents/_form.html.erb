<% back = case document.documentable
          when Contract then contract_path(document.documentable)
          when Proposal then proposal_path(document.documentable)
          when Project then project_path(document.documentable, aba: "documentos")
          when Company then params[:voltar] == "empresa" ? company_path(document.documentable, aba: "documentos") : documents_path
          else documents_path end %>
<%= render layout: "shared/drawer_form", locals: { title: "Enviar arquivo", cancel_path: back } do %>
  <%= form_with model: document, class: "form", data: { turbo_frame: "_top" } do |f| %>
    <%= hidden_field_tag :voltar, params[:voltar] if params[:voltar] %>
    <div class="drawer-body form">
      <%= render "shared/form_errors", record: document %>
      <div class="field">
        <%= f.label :file do %>Arquivo <span class="req">*</span><% end %>
        <%= f.file_field :file, class: "input", required: true %>
        <span class="hint">Até 25 MB. Fica guardado no armazenamento seguro (S3 em produção).</span>
      </div>
      <div class="form-grid">
        <div class="field full"><%= f.label :title, "Título" %><%= f.text_field :title, class: "input", placeholder: "Usa o nome do arquivo se ficar em branco" %></div>
        <div class="field"><%= f.label :kind do %>Tipo <span class="req">*</span><% end %><%= f.select :kind, Document.options_for_kind, {}, class: "select" %></div>
        <div class="field">
          <%= f.label :documentable_id do %>Vínculo <span class="req">*</span><% end %>
          <% if document.documentable %>
            <%= f.hidden_field :documentable_type %><%= f.hidden_field :documentable_id %>
            <input class="input" value="<%= case document.documentable
                                              when Contract then "Contrato #{document.documentable.code} · #{document.documentable.company.trade_name}"
                                              when Proposal then "Proposta #{document.documentable.code} · #{document.documentable.recipient_name}"
                                              when Project then "Projeto #{document.documentable.name} · #{document.documentable.company.trade_name}"
                                              else document.documentable.to_s end %>" disabled>
          <% else %>
            <%= f.hidden_field :documentable_type, value: "Company" %>
            <%= f.collection_select :documentable_id, Company.by_name, :id, :trade_name, { include_blank: "Selecione o cliente" }, class: "select", required: true %>
          <% end %>
        </div>
      </div>
      <div class="field"><%= f.label :notes, "Observações" %><%= f.text_area :notes, class: "textarea", placeholder: "Notas sobre o documento" %></div>
      <p class="caption" style="margin:0">Enviado por <%= current_user.name %> em <%= date_br(Date.current) %>.</p>
    </div>
    <div class="drawer-foot">
      <%= link_to "Cancelar", back, class: "btn", data: { close: true, turbo_frame: "_top" } %>
      <%= f.submit "Enviar", class: "btn pri" %>
    </div>
  <% end %>
<% end %>
