# Copie para .env e preencha. O .env não vai para o git.

# Produção
APP_HOST=admin.devbatista.com
DEVBATISTA_DATABASE_PASSWORD=
REDIS_URL=redis://localhost:6379/0
MAILER_SENDER="Admin DevBatista <nao-responda@devbatista.com>"

# Arquivos (Active Storage → S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=sa-east-1
AWS_BUCKET=devbatista-admin-production

# E-mail (Amazon SES, interface SMTP). Use a chave IAM com permissão ses:SendRawEmail
# (a senha SMTP é derivada dela) ou as credenciais SMTP geradas no console do SES.
SES_REGION=sa-east-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# SES_SMTP_USERNAME=
# SES_SMTP_PASSWORD=

# Seeds em produção: senha inicial do primeiro administrador
SEED_PASSWORD=
