# Copie para .env e preencha. O .env não vai para o git.

# Produção
APP_HOST=admin.devbatista.com
DEVBATISTA_DATABASE_PASSWORD=
REDIS_URL=redis://localhost:6379/0
MAILER_SENDER="Admin DevBatista <nao-responda@devbatista.com>"

# Arquivos (Active Storage → S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=sa-east-1
AWS_BUCKET=devbatista-admin-production

# E-mail (Amazon SES, interface SMTP). Use a chave IAM com permissão ses:SendRawEmail
# (a senha SMTP é derivada dela) ou as credenciais SMTP geradas no console do SES.
SES_REGION=sa-east-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# SES_SMTP_USERNAME=
# SES_SMTP_PASSWORD=

# WhatsApp Business (Cloud API da Meta). App "DevBatista Admin" no painel de desenvolvedores da Meta.
META_APP_ID=
META_APP_SECRET=
# Configuração do Embedded Signup (Facebook Login for Business → Configurações)
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
# Texto livre; o mesmo informado no webhook do app na Meta
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v26.0

# Active Record Encryption (token das contas do WhatsApp). Gere com: bin/rails db:encryption:init
# Sem estas variáveis, valem as credentials. Precisam estar no Railway antes de conectar o número
# (fase 4); sem elas, o boot registra um erro no log. Trocar ou perder as chaves torna ilegíveis
# os tokens já salvos: guarde uma cópia segura no cofre de senhas.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Seeds em produção: senha inicial do primeiro administrador
SEED_PASSWORD=
